<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Stepq" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- System splash: leaf green, like A01 Splash, before Compose draws the first frame. -->
    <style name="Theme.Stepq.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/leaf</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Stepq</item>
    </style>
</resources>
