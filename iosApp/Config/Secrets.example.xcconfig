// Copy to Secrets.xcconfig (git-ignored) and fill in.
// The anon / publishable key only. Never the service_role key: it would ship inside the app.
SUPABASE_ANON_KEY = paste-the-anon-key-here
// Your Apple Developer Team ID (Xcode → Settings → Accounts, or developer.apple.com → Membership).
DEVELOPMENT_TEAM = ABCDE12345
